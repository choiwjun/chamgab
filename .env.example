# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_BOOTSTRAP=false
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Kakao Maps
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-map-key

# Naver OAuth (네이버 로그인)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ML API
ML_API_URL=http://localhost:8000
NEXT_PUBLIC_ML_API_URL=http://localhost:8002
ML_ADMIN_TOKEN=change-me

# Scheduler auto-retry
SCHEDULER_AUTO_RETRY_ENABLED=true
SCHEDULER_AUTO_RETRY_MAX_ATTEMPTS=2
SCHEDULER_AUTO_RETRY_DELAY_SEC=60
SCHEDULER_AUTO_RETRY_EXP_BACKOFF=true
# Optional override (comma separated). Default includes:
# chamgab_gap_recovery_full,school_full_rebuild,collect_commercial,
# build_commercial_quality_snapshot,check_commercial_data_quality,check_launch_readiness_gate
# SCHEDULER_AUTO_RETRY_JOB_TYPES=

# Scheduler watchdog (server-side auto requeue for critical chain)
SCHEDULER_WATCHDOG_ENABLED=true
SCHEDULER_WATCHDOG_RUN_ON_START=true
SCHEDULER_WATCHDOG_INTERVAL_SEC=180
SCHEDULER_WATCHDOG_QUEUE_MISSING_JOBS=true
SCHEDULER_WATCHDOG_REQUEUE_FAILED=true
SCHEDULER_WATCHDOG_COOLDOWN_SEC=300
SCHEDULER_WATCHDOG_MAX_REQUEUE_PER_JOB=12
SCHEDULER_WATCHDOG_QUEUE_DELAY_SEC=2
# Optional override (comma separated):
# SCHEDULER_WATCHDOG_JOB_ORDER=chamgab_gap_recovery_full,school_full_rebuild,collect_commercial,build_commercial_quality_snapshot,check_commercial_data_quality,check_launch_readiness_gate

# Chamgab factor backfill model bootstrap
CHAMGAB_FACTOR_BACKFILL_AUTO_BOOTSTRAP_MODEL=true
CHAMGAB_MODEL_BOOTSTRAP_TIMEOUT_SEC=7200

# Anonymous (guest) analysis daily limit (per IP hash)
ANON_DAILY_ANALYSIS_LIMIT=3

# Credit costs per analysis product
CREDIT_COST_COMMERCIAL=1
CREDIT_COST_HOME_PRICE=2
CREDIT_COST_LAND=4

# Free open mode (temporarily disable billing/credit gating)
FREE_OPEN_MODE=false
NEXT_PUBLIC_FREE_OPEN_MODE=false

# School analysis share token signing secret
SCHOOL_ANALYSIS_SHARE_SECRET=change-me

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Sentry (Optional)
NEXT_PUBLIC_SENTRY_DSN=

# Environment
NODE_ENV=development
