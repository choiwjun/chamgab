# Web application: Neon + Cloudflare Workers
DATABASE_URL=postgresql://chamgab_owner:password@your-endpoint.neon.tech/chamgab?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/chamgab/rest/v1
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.region.aws.neon.tech/chamgab/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional integrations
NEXT_PUBLIC_KAKAO_MAP_KEY=
ML_API_URL=
NEXT_PUBLIC_ML_API_URL=
ML_ADMIN_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_ENABLE_LAND=false
# Configure collection/training separately with ml-api/.env.example.
