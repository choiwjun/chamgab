# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chamgab

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# 국토교통부 Open API
MOLIT_API_KEY=your-molit-api-key

# 한국부동산원 R-ONE API
REB_API_KEY=your-reb-api-key

# 소상공인진흥공단 API (상권 분석)
SBIZ_API_KEY=your-sbiz-api-key

# Kakao Local API (POI 검색) - REST API 키 사용 (JavaScript 키 아님!)
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# NEIS Open API (schoolInfo, acaInsTiInfo)
NEIS_API_KEY=your-neis-api-key

# 한국교육개발원 시군구별 대학진학률 (api.odcloud.kr/api/15053808/v1)
# 공공데이터포털(data.go.kr)에서 신청 - "한국교육개발원_시도 시군구별 출업자 진학자 진학률"
ODCLOUD_ADVANCEMENT_API_KEY=your-odcloud-advancement-api-key

# 학교알리미 OpenAPI (schoolinfo.go.kr) - 학교별 공시 데이터
# https://www.schoolinfo.go.kr/ei/pc/peipnso001m.do 에서 신청
SCHOOLINFO_API_KEY=your-schoolinfo-api-key

# Supabase DB Password (마이그레이션 직접 실행 시)
SUPABASE_DB_PASSWORD=your-database-password

# Serving-time calibration (recent transaction anchoring)
# 1: enabled (default), 0: disabled
APARTMENT_SERVING_CALIBRATION=1

# Gap recovery full chain option
# true: run school_full_rebuild automatically after chamgab_gap_recovery_full
# false: do not chain school_full_rebuild
CHAMGAB_GAP_RECOVERY_CHAIN_SCHOOL_FULL_REBUILD=true

# Scheduler admin token (required for /api/scheduler/*)
ML_ADMIN_TOKEN=your-admin-token

# Web app base URL for launch readiness gate checks
# ex) https://chamgab.vercel.app
APP_BASE_URL=https://your-web-app-domain

# Gap recovery full periodic schedule (server-side cron)
CHAMGAB_GAP_RECOVERY_CRON_ENABLED=true
CHAMGAB_GAP_RECOVERY_CRON_DAY_OF_WEEK=sun
CHAMGAB_GAP_RECOVERY_CRON_HOUR=1
CHAMGAB_GAP_RECOVERY_CRON_MINUTE=10

# Commercial periodic schedule (server-side cron)
COLLECT_COMMERCIAL_CRON_DAY_OF_WEEK=fri
COLLECT_COMMERCIAL_CRON_HOUR=2
COLLECT_COMMERCIAL_CRON_MINUTE=0
BUILD_COMMERCIAL_QUALITY_SNAPSHOT_CRON_HOUR=3
BUILD_COMMERCIAL_QUALITY_SNAPSHOT_CRON_MINUTE=10
CHECK_COMMERCIAL_DATA_QUALITY_CRON_HOUR=3
CHECK_COMMERCIAL_DATA_QUALITY_CRON_MINUTE=20
CHECK_LAUNCH_READINESS_GATE_CRON_HOUR=3
CHECK_LAUNCH_READINESS_GATE_CRON_MINUTE=30

# Land periodic schedule (server-side cron)
# Keep this out of the critical 00:00~03:30 window.
LAND_COLLECTION_CRON_HOUR=6
LAND_COLLECTION_CRON_MINUTE=20

# Land chunk collection options
LAND_TX_GROUP=0
LAND_TX_CHUNK_LIMIT=900
LAND_PRICE_CHUNK_LIMIT=500
LAND_PRICE_SLEEP_MS=120
# Optional regional chunk lock:
# LAND_PRICE_SIGUNGU=강남구
LAND_CHARACTERISTICS_CHUNK_LIMIT=500
LAND_CHARACTERISTICS_SLEEP_MS=120
# Optional regional chunk lock:
# LAND_CHARACTERISTICS_SIGUNGU=강남구

# Land parcel location geocoding (separate batch)
LAND_LOCATION_CRON_ENABLED=true
LAND_LOCATION_CRON_HOUR=7
LAND_LOCATION_CRON_MINUTE=10
LAND_LOCATION_CHUNK_LIMIT=500
LAND_LOCATION_SLEEP_MS=180
LAND_LOCATION_TIMEOUT_SEC=12
LAND_LOCATION_JOB_TIMEOUT_SEC=3600
# Optional regional chunk lock:
# LAND_LOCATION_SIGUNGU=강남구

# Scheduler auto-retry (critical jobs)
SCHEDULER_AUTO_RETRY_ENABLED=true
SCHEDULER_AUTO_RETRY_MAX_ATTEMPTS=2
SCHEDULER_AUTO_RETRY_DELAY_SEC=60
SCHEDULER_AUTO_RETRY_EXP_BACKOFF=true
# Optional override (comma-separated):
# SCHEDULER_AUTO_RETRY_JOB_TYPES=chamgab_gap_recovery_full,school_full_rebuild,collect_commercial,build_commercial_quality_snapshot,check_commercial_data_quality,check_launch_readiness_gate

# Scheduler watchdog (server-side auto requeue for critical chain)
SCHEDULER_WATCHDOG_ENABLED=true
SCHEDULER_WATCHDOG_RUN_ON_START=true
SCHEDULER_WATCHDOG_INTERVAL_SEC=180
SCHEDULER_WATCHDOG_QUEUE_MISSING_JOBS=true
SCHEDULER_WATCHDOG_REQUEUE_FAILED=true
SCHEDULER_WATCHDOG_COOLDOWN_SEC=300
SCHEDULER_WATCHDOG_MAX_REQUEUE_PER_JOB=12
SCHEDULER_WATCHDOG_QUEUE_DELAY_SEC=2
# Optional override (comma-separated):
# SCHEDULER_WATCHDOG_JOB_ORDER=chamgab_gap_recovery_full,school_full_rebuild,collect_commercial,build_commercial_quality_snapshot,check_commercial_data_quality,check_launch_readiness_gate

# Commercial quality gate exit mode
# true: warning mode (job returns success even when gate fails)
# false: strict mode (job fails when gate fails)
COMMERCIAL_QUALITY_SOFT_FAIL=true

# Chamgab factor backfill model bootstrap
# true: if apartment model artifacts are missing, run scripts.train_model automatically
# false: fail immediately when artifacts are missing
CHAMGAB_FACTOR_BACKFILL_AUTO_BOOTSTRAP_MODEL=true
CHAMGAB_MODEL_BOOTSTRAP_TIMEOUT_SEC=21600

# Apartment model artifact remote sync (Supabase Storage)
# restore: try storage download before expensive bootstrap training
# upload: after bootstrap training, push artifacts back to storage
CHAMGAB_MODEL_ARTIFACTS_RESTORE_ENABLED=true
CHAMGAB_MODEL_ARTIFACTS_UPLOAD_AFTER_BOOTSTRAP=true
ML_MODEL_ARTIFACT_BUCKET=ml-models
APARTMENT_MODEL_ARTIFACT_PREFIX=apartment/latest
MODEL_ARTIFACT_IO_RETRIES=3
MODEL_ARTIFACT_IO_RETRY_DELAY_SEC=2

# Supabase client network timeout tuning (seconds)
SUPABASE_HTTP_TIMEOUT_SEC=600
SUPABASE_HTTP_CONNECT_TIMEOUT_SEC=30
